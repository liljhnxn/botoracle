{
  "name": "botoracle",
  "version": "1.0.0",
  "description": "BotOracle - Decentralized Oracle Network Protocol on BOT Chain Mainnet",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:botchain": "hardhat run scripts/deploy.ts --network botchain",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network botchain",
    "seed:local": "hardhat run scripts/seed.ts --network localhost",
    "oracle": "npm --prefix oracle-node run start",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.0",
    "chai": "^4.4.1",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
